# Gradescope credentials (required). `python -m gradescope_mcp` loads this
# file as `.env` from the project directory; variables already set in the
# environment (e.g. an MCP client's `env` block) take precedence.

GRADESCOPE_EMAIL=your_email@example.com
GRADESCOPE_PASSWORD=your_password

# Optional settings: uncomment to use.

# Private cache root for grading artifacts and page images. Must be a
# directory owned by you with mode 0700 (created 0700 if missing). Default:
# $XDG_RUNTIME_DIR/gradescope-mcp, else <system temp dir>/gradescope-mcp-<uid>.
# GRADESCOPE_MCP_CACHE_DIR=/path/to/private/cache

# Read timeout in seconds for Gradescope requests (default 60); the connect
# timeout is min(10, this value).
# GRADESCOPE_MCP_HTTP_TIMEOUT=60

# Directories that tool_upload_submission files must resolve inside,
# separated by ':' (';' on Windows). Unset: no directory restriction, but
# symlinks and system directories are refused.
# GRADESCOPE_MCP_UPLOAD_ROOT=/path/to/submissions
